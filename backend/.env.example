# ── Neon PostgreSQL ──────────────────────────────────────────
# Neon Console → Connection string (Pooled)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require

# ── Firebase Admin SDK ───────────────────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
# Cole o private_key do JSON gerado, mantendo as quebras de linha como \n
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAA...\n-----END RSA PRIVATE KEY-----\n"

# ── Cloudflare R2 Storage ─────────────────────────────────────
# Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=abc123def456
R2_BUCKET_NAME=twoplayers-media
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Endpoint do bucket (substitua o account id)
R2_ENDPOINT=https://abc123def456.r2.cloudflarestorage.com
# URL pública: ativar em R2 → Bucket → Settings → Public Access
R2_PUBLIC_URL=https://media.twoplayers.com

# ── Mercado Pago (apenas se usar pagamento real) ──────────────
# Painel MP: Suas integrações → Credenciais
MP_ACCESS_TOKEN=APP_USR-your-access-token
MP_SANDBOX=true
MP_WEBHOOK_SECRET=your-webhook-secret
MP_WEBHOOK_URL=https://api.twoplayers.com/api/payments/webhook
MP_SUCCESS_URL=https://twoplayers.com/pagamento/sucesso
MP_FAILURE_URL=https://twoplayers.com/pagamento/falha
MP_PENDING_URL=https://twoplayers.com/pagamento/pendente

# ── CORS ─────────────────────────────────────────────────────
# URL do frontend em produção. Múltiplos domínios separados por vírgula.
# Exemplo: https://twoplayers.vercel.app,https://www.twoplayers.com
FRONTEND_URL=https://your-app.vercel.app

# ── Servidor ─────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
